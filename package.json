{
  "name": "loud-voice-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Bot Voice Studio & Discord Control Center",
  "scripts": {
    "dev": "tsx src/server/server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx src/server/server.ts",
    "db:migrate": "prisma migrate dev --name init",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:migrate-developer": "node scripts/migrate-to-developer.js",
    "setup": "bash setup.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/patch-opusscript.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.41.6",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "discord-api-types": "^0.37.119",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
