# ==============================================================================
# LOUD VOICE STUDIO - PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================
# Copy this file to .env and configure the credentials below.
# Or simply run: bash setup.sh
# ==============================================================================

# 1. SERVER CONFIGURATION
NODE_ENV=production
HOST="0.0.0.0"
PORT=3000
MEDIA_GATEWAY_PORT=3001
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_WS_URL="wss://your-domain.com/media-stream"

# 2. DATABASE CONFIGURATION (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/loud_db?schema=public"

# 3. REDIS CONFIGURATION (BullMQ Queue & Telemetry Broker)
REDIS_URL="redis://localhost:6380"

# 4. DISCORD OAUTH2 (FOR DASHBOARD LOGIN)
# 1) Go to https://discord.com/developers/applications
# 2) Select or create your Discord Application
# 3) Copy Client ID and Client Secret (under OAuth2 tab)
# 4) Add Redirect URI in Discord Developer Portal:
#    https://your-domain.com/api/auth/discord/callback (or http://YOUR_SERVER_IP:3000/api/auth/discord/callback)
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
DISCORD_REDIRECT_URI="https://your-domain.com/api/auth/discord/callback"

# 5. SECURITY & ENCRYPTION
# Must be a 64-character (32-byte) hex string for AES-256-GCM credential encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="GENERATE_A_RANDOM_LONG_STRING_FOR_JWT_SESSION_TOKENS"
MEDIA_SESSION_SECRET="GENERATE_A_RANDOM_LONG_STRING_FOR_MEDIA_SESSION_TOKENS"
SESSION_COOKIE_NAME="loud_session"

# 6. DEVELOPER ID & FLEET ACCESS CONTROL
# Developer ID 788970167907778562 has supreme unrestricted fleet commander access
ADMIN_USER_IDS="788970167907778562"

# 7. FLEET DEFAULTS & LIMITS
MAX_BOTS_PER_WORKSPACE=100
MAX_CONCURRENT_VOICE_ENDPOINTS=50
DEFAULT_DISCORD_SCOPES="bot applications.commands"
