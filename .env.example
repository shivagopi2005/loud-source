# Application Environment Configuration
NODE_ENV=development
PORT=3000
MEDIA_GATEWAY_PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loud_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# Discord OAuth2 Application Credentials (for user dashboard login)
DISCORD_CLIENT_ID="123456789012345678"
DISCORD_CLIENT_SECRET="mock_discord_client_secret_xyz"
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# Security & Encryption (AES-256-GCM 32-byte key in hex or base64)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="super_secret_jwt_key_for_development_purposes_only_loud_platform"
SESSION_COOKIE_NAME="loud_session"
MEDIA_SESSION_SECRET="super_media_session_key_32_bytes_long_here!"

# Bot Defaults & Fleet Limits
MAX_BOTS_PER_WORKSPACE=25
MAX_CONCURRENT_VOICE_ENDPOINTS=10
DEFAULT_DISCORD_SCOPES="bot applications.commands"
